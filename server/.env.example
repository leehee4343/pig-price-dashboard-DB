# 이 파일을 복사해서 .env로 저장하고 실제 값을 채워넣으세요. .env는 git에 커밋되지 않습니다.

# 업로드 화면 로그인 비밀번호 (팀원과 공유)
UPLOAD_PASSWORD=

# 세션 쿠키 서명용 임의의 긴 문자열 (아무 값이나 무작위로 생성)
SESSION_SECRET=

# GitHub Fine-grained Personal Access Token
# - Resource owner: 저장소 소유 계정
# - Repository access: 이 저장소(pig-price-dashboard)만 선택
# - Permissions: Contents = Read and write (그 외는 불필요)
GITHUB_TOKEN=

GITHUB_OWNER=leehee4343
GITHUB_REPO=pig-price-dashboard

# 로컬 테스트용 포트 (Render 등 호스팅에서는 플랫폼이 자동으로 지정하므로 보통 필요 없음)
PORT=3100
